{
  "rewrites": [
    {
      "source": "/api/map-pin",
      "destination": "/api/map?mode=pin"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/recalibrate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/watchdog",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "lib/data/forest-grid.*",
      "maxDuration": 60
    }
  }
}
