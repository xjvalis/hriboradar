# Copy this file to .env (same folder) and fill in real values from your
# Supabase project (Settings → API). Expo picks up .env automatically -
# no extra config needed, just restart `expo start` after editing it.
#
# EXPO_PUBLIC_ prefix is required - Expo only inlines env vars into the
# client bundle if they start with it. These two are meant to be public
# (Supabase's Row Level Security protects data server-side, not secrecy
# of the anon key).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google and Apple sign-in are configured on the Supabase side (Authentication
# → Providers), not here - once you add a Google OAuth client there, it
# works automatically through the existing code, no further env vars needed.

# RevenueCat public SDK keys (revenuecat.com - Project settings - API keys).
# One per storefront: iOS talks to StoreKit, Android to Google Play Billing,
# both through react-native-purchases; the web build has no purchase path
# yet (see SubscriptionContext.web.tsx), so EXPO_PUBLIC_REVENUECAT_WEB_KEY
# isn't used today - only kept here for when Web Billing is wired in.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
