SUPABASE_URL=https://jkzilxswnsqjudundomb.supabase.co
SUPABASE_ANON_KEY=
# Only needed to run the nightly recalibration job locally (api/cron/recalibrate.ts).
# Get from Supabase dashboard - Settings - API - service_role key. Never expose this
# to the mobile app or commit it; it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret checked by api/cron/recalibrate.ts. Set the same value here and in
# Vercel's project env vars - Vercel automatically sends it as the cron job's
# Authorization header when both are named CRON_SECRET.
CRON_SECRET=
