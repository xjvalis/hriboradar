SUPABASE_URL=https://jkzilxswnsqjudundomb.supabase.co
SUPABASE_ANON_KEY=
# Only needed to run the nightly recalibration job locally (api/cron/recalibrate.ts).
# Get from Supabase dashboard - Settings - API - service_role key. Never expose this
# to the mobile app or commit it; it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret checked by api/cron/recalibrate.ts. Set the same value here and in
# Vercel's project env vars - Vercel automatically sends it as the cron job's
# Authorization header when both are named CRON_SECRET.
CRON_SECRET=

# Resend API key (resend.com) - used by lib/email.ts to send subscription
# transactional emails (activated/canceled/billing issue). Without it,
# sendEmail() logs and no-ops instead of failing the webhook.
RESEND_API_KEY=

# Shared secret checked by api/webhooks/revenuecat.ts against the incoming
# Authorization: Bearer header. Set the same value here and in the
# RevenueCat dashboard's webhook config (Project settings - Integrations -
# Webhooks - Authorization header value).
REVENUECAT_WEBHOOK_SECRET=
